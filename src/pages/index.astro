---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Ted Tech - Technical Sharing">
  <Header />
  <main class="main">
    <div class="container">
      <section class="hero">
        <h1 class="hero-title">Ted Tech</h1>
        <p class="hero-desc">Technical sharing — cloud infrastructure, DevOps, and beyond.</p>
      </section>

      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-state-icon">✍️</div>
          <p>No posts yet. Drop a markdown file into <code>src/content/posts/</code> to get started.</p>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
