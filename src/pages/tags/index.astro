---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const posts = await getCollection('posts');

// Collect all unique tags and their post counts
const tagMap = new Map<string, number>();
for (const post of posts) {
  if (post.data.draft) continue;
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}

const tags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

function tagSize(count: number, max: number): string {
  if (max <= 1) return 'md';
  const ratio = count / max;
  if (ratio > 0.6) return 'lg';
  if (ratio < 0.3) return 'sm';
  return 'md';
}

const maxCount = Math.max(...tags.map((t) => t.count), 1);
---

<BaseLayout title="Tags | Ted Tech">
  <Header />
  <main class="main">
    <div class="container" style="max-width: var(--w-content)">
      <div class="page-header">
        <h1 class="page-title">Tags</h1>
        <p class="page-desc">{tags.length} tags across all posts</p>
      </div>

      {tags.length > 0 ? (
        <div class="tags-cloud">
          {tags.map((t) => (
            <a
              href={`/tags/${t.name.toLowerCase().replace(/\s+/g, '-')}/`}
              class={`tag tag-${tagSize(t.count, maxCount)}`}
            >
              {t.name}
              <span style="opacity: 0.6; margin-left: 0.3em">({t.count})</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No tags yet. Add tags to your post front-matter to see them here.</p>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
