---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  // Collect all unique tag slugs
  const tagSlugs = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tagSlugs.add(tag.toLowerCase().replace(/\s+/g, '-'));
    }
  }

  return Array.from(tagSlugs).map((slug) => ({
    params: { tag: slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .filter((p) =>
    p.data.tags.some(
      (t: string) => t.toLowerCase().replace(/\s+/g, '-') === slug
    )
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Find the original tag name (case-preserved)
const originalTag =
  posts[0]?.data.tags.find(
    (t: string) => t.toLowerCase().replace(/\s+/g, '-') === slug
  ) || slug;
---

<BaseLayout title={`${originalTag} | Tags | Ted Tech`}>
  <Header />
  <main class="main">
    <div class="container" style="max-width: var(--w-content)">
      <div class="page-header">
        <h1 class="page-title">
          <span style="color: var(--c-text-3); font-weight: 400">#</span> {originalTag}
        </h1>
        <p class="page-desc">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>
      </div>

      <div class="post-list">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>

      <div style="margin-top: 2rem">
        <a href="/tags/" style="color: var(--c-text-2); font-size: 0.9rem">← All tags</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
